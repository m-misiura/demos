{
  "name": "garak-owasp-llm01-selected-probes",
  "model": {
    "url": "https://<YOUR-FMS-URL>/api/v2/chat/completions-detection",
    "name": "llm"
  },
  "benchmarks": [
    {
      "id": "owasp_llm_top10",
      "provider_id": "garak",
      "parameters": {
        "model_type": "rest.RestGenerator",
        "timeout_seconds": 1800,
        "probes": ["dan.Dan_11_0", "promptinject.HijackKillHumans", "encoding.InjectBase64"],
        "garak_config": {
          "plugins": {
            "target_type": "rest.RestGenerator",
            "generators": {
              "rest": {
                "RestGenerator": {
                  "uri": "https://<YOUR-FMS-URL>/api/v2/chat/completions-detection",
                  "name": "llm",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "req_template_json_object": {
                    "model": "llm",
                    "messages": [
                      { "role": "user", "content": "$INPUT" }
                    ],
                    "detectors": {
                      "input": { "detector": {}, "built-in-detector": {} },
                      "output": { "detector": {}, "built-in-detector": {} }
                    }
                  },
                  "response_json": true,
                  "response_json_field": "$.choices[0].message.content",
                  "verify_ssl": false,
                  "request_timeout": 120
                }
              }
            }
          }
        }
      }
    }
  ],
  "tags": ["owasp", "prompt-injection", "security", "garak"]
}
